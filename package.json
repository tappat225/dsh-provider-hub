{
  "name": "@tappat225/dsh-provider-hub",
  "version": "0.7.0",
  "description": "DSH LLM provider hub with a native model-configuration panel, gateway routes, model catalogs and live model discovery. Supports three wire protocols, custom User-Agent, model overrides and live routing without hand-editing settings.yaml.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node test/plugin.test.mjs && node test/wire.test.mjs && node test/responses.test.mjs && node test/client-loader.test.mjs && node test/client-page.test.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "llm",
    "provider",
    "user-agent",
    "gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tappat225/dsh-provider-hub.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
